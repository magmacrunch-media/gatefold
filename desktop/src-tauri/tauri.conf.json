{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GATEFOLD",
  "version": "1.10.1",
  "identifier": "com.magmacrunch.gatefold",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "windows": [
      {
        "title": "GATE//FOLD",
        "url": "ui/index.html",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "magmacrunch media LLC",
    "copyright": "Copyright 2026 magmacrunch media",
    "shortDescription": "GATE//FOLD",
    "longDescription": "GATE//FOLD"
  }
}
